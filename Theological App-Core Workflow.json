    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"model\": \"claude-sonnet-4-6\", \"max_tokens\": 800, \"messages\": [ { \"role\": \"user\", \"content\": \"Write a short, warm, theologically grounded devotional (250-350 words) based on this topic or passage: \" + $json.body.topic + \". Include: 1) a relevant scripture reference, 2) a short reflection, 3) one practical application, 4) a closing prayer prompt.\" } ] } }}",
        "options": {}
      },
